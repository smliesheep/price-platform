# ---- 通用 ----
PP_LOG_LEVEL=INFO
PP_TZ=Asia/Shanghai

# ---- 依赖 ----
PP_DATABASE_URL=postgresql://price:price@localhost:5432/price
PP_REDIS_URL=redis://localhost:6379/0

# ---- 队列 ----
PP_QUEUE_STREAM=price:tasks
PP_QUEUE_GROUP=workers
PP_QUEUE_DLQ=price:tasks:dlq
PP_RETRY_ZSET=price:retry

# ---- scheduler ----
PP_SCHEDULER_TICK_SEC=30
PP_SCHEDULER_BATCH=200
PP_PROMOTE_INTERVAL_SEC=1

# ---- worker ----
PP_WORKER_CONCURRENCY=2
PP_WORKER_TIMEOUT_SEC=300
PP_WORKER_MAX_RETRY=3
PP_RETRY_DELAY_SEC=5
PP_WORKER_HEARTBEAT_SEC=15
PP_BROWSER_HEADLESS=true
PP_SELECTOR_DIR=./configs/selectors
PP_MOCK_SHOP_URL=http://localhost:8080

# ---- reaper ----
PP_REAPER_INTERVAL_SEC=15
PP_ORPHAN_GRACE_SEC=30
PP_STALE_QUEUED_SEC=30
PP_STALE_RETRY_WAIT_SEC=60
PP_WORKER_HEARTBEAT_TIMEOUT_SEC=90

# ---- api ----
PP_JWT_SECRET=dev-secret-change-me
PP_JWT_EXPIRE_MIN=720
PP_ADMIN_USERNAME=admin
# 明文 admin123 的 bcrypt hash（本地开发用，生产必须换）
PP_ADMIN_PASSWORD_HASH=$2b$12$LQv3c1yqBWVHxkd0LHAkCOYz6TtxMQJqhN8/LewdBPj4J/2Kqj5K6
PP_DISABLE_AUTH=false

# ---- metrics ----
PP_METRICS_PORT=9100
